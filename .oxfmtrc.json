{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "sortImports": {
    "internalPattern": ["@better-eh/"],
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/style.css",
    "attributes": [":class"]
  },
  "ignorePatterns": ["pnpm-lock.yaml"]
}
