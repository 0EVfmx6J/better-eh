{
  "name": "better-eh-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @better-eh/userscript dev",
    "build": "pnpm --filter @better-eh/userscript build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --filter @better-eh/userscript typecheck",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:"
  }
}
